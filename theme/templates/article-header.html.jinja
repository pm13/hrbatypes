{% if article.category not in ('Archív', 'Stupně vítězů') %}
  <p class="italic">
    {{ article.locale_date }} – {{ article.author }}
    {% if link_to_category %}
      – <a href="/{{ article.category.url }}">{{ article.category }}</a>
    {% else %}
      – {{ article.category }}
    {% endif %}
  </p>
{% endif %}
