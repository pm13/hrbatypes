{% from 'macros.html.jinja' import local_nav_unit, article_header %}
{% from 'macros.html.jinja' import local_link with context %}

<!DOCTYPE html>
<html lang="{{ DEFAULT_LANG }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{% block title %}{% endblock %} | {{ SITENAME }}</title>
    <link rel="stylesheet" href="/theme/{{ 'site.css' if CSS_DEBUG else 'site.min.css' }}">
    <link rel="icon" href="/favicon.ico">
  </head>
  <body class="bg-base-100 text-base-content">
    <nav class="navbar bg-primary">
      <div class="flex w-full max-w-4xl mx-auto">
        <div class="navbar-start">
          <button class="btn btn-ghost btn-square md:hidden" popovertarget="megamenu" aria-label="Otevřít navigaci">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          <a href="/" class="flex items-center gap-2">
            <img src="/theme/logo.png" alt="" class="h-8">
            <span class="text-xl font-semibold whitespace-nowrap">{{ SITENAME }}</span>
          </a>
        </div>
        <div class="navbar-end">
          <div class="megamenu max-md:megamenu-vertical" id="megamenu" popover>
            <span class="megamenu-active"></span>
            <button class="text-lg font-medium px-3 whitespace-nowrap" popovertarget="menu-aktuality">
              Aktuality
            </button>
            <div id="menu-aktuality" popover>
              <ul class="menu">
                {% for article in (all_articles or articles)[:5] %}
                  <li><a href="{{ '/' ~ article.url }}">{{ article.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
            <button class="text-lg font-medium px-3 whitespace-nowrap" popovertarget="menu-sezony">
              Sezóny
            </button>
            <div id="menu-sezony" popover>
              <ul class="menu">
                {% for category, articles in (categories|sort_categories)[:5] %}
                  <li><a href="{{ '/' ~ category.url }}">{{ category.name }}</a></li>
                {% endfor %}
              </ul>
            </div>
            <button class="text-lg font-medium px-3 whitespace-nowrap" popovertarget="menu-stupne">
              Stupně vítězů
            </button>
            <div id="menu-stupne" popover>
              <ul class="menu">
                {% for category, articles in (categories|sort_categories)[:5] %}
                  <li><a href="{{ '/' ~ category.url }}">{{ category.name }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
          <a
            href="https://clenove.hrbatypes.cz/"
            class="text-lg font-medium flex h-10 items-center px-3 whitespace-nowrap hover:bg-primary-content/10">
            Pro členy
          </a>
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <article
        class="
          prose max-w-none
          prose-headings:font-medium
          prose-h2:mt-8 prose-h2:mb-4
          prose-li:my-1
          prose-a:text-accent prose-a:no-underline prose-a:hover:underline
          prose-tr:even:bg-base-200
        ">
        {% block content %}{% endblock %}
      </article>
    </main>
  </body>
</html>
